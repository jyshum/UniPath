{
  "metadata": {
    "version": "1.0",
    "date_compiled": "2026-04-30",
    "notes": "Undergraduate programs at 11 Canadian universities. Tier 1 = full detail, Tier 2 = common programs only. Excludes co-op designations. Admission types: 'faculty' = admitted to broad faculty first, pick specialization later; 'direct' = admitted directly to specific program.",
    "schools": {
      "tier_1": ["UBC Vancouver", "University of Waterloo", "University of Toronto", "Western University", "Queen's University", "McMaster University", "Simon Fraser University"],
      "tier_2": ["University of Alberta", "University of Calgary", "University of Ottawa", "Dalhousie University"]
    },
    "admission_notes": {
      "UBC Vancouver": {
        "engineering": "faculty",
        "science": "faculty",
        "arts": "faculty",
        "commerce": "direct",
        "note": "Engineering and Science admit to faculty first year; students pick specialization after Year 1. Sauder Commerce is direct admission."
      },
      "University of Toronto": {
        "engineering": "mixed",
        "note": "TrackOne (undeclared) is faculty-first. Core 8 programs (Chemical, Civil, Computer, Electrical, EngSci, Industrial, Materials, Mechanical, Mineral) are direct-entry but students can switch after first year. Arts & Science admits to faculty, picks POSt after Year 1."
      },
      "University of Waterloo": {
        "all": "direct",
        "note": "All programs are direct admission. Students apply to a specific program."
      },
      "Western University": {
        "engineering": "direct",
        "science": "faculty",
        "note": "Engineering admits to specific discipline. Science admits broadly, picks module after Year 1."
      },
      "Queen's University": {
        "engineering": "faculty",
        "note": "Engineering admits to general first year; students select discipline after Year 1. Commerce and Arts/Science are direct."
      },
      "McMaster University": {
        "engineering": "faculty",
        "note": "Engineering I is common first year; students rank programs and are placed by GPA. Health Sciences is direct."
      },
      "Simon Fraser University": {
        "all": "faculty",
        "note": "Students generally admitted to a faculty and declare major later. Some programs like Computing Science have direct entry."
      }
    }
  },
